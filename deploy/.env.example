# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain, with its DNS A record pointing at the server's static IP.
DOMAIN=example.com

# Hours a login lasts before the access code is asked again (default 24).
SESSION_HOURS=24

# Use only letters and digits (it is put inside a connection URL). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Backups (used by deploy/backup.sh)
# File containing the passphrase that encrypts backups. Keep a copy somewhere safe, off the server.
BACKUP_PASSPHRASE_FILE=/root/backup-passphrase
BACKUP_DIR=/var/backups/one-zero-two
# Optional: also upload each backup to a bucket, e.g. s3://my-bucket/one-zero-two (needs the aws CLI).
BACKUP_S3_URI=
