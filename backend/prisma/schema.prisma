generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One row per person. The access code is stored only as a salted scrypt hash.
model User {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  codeHash  String    @map("code_hash")
  codeSalt  String    @map("code_salt")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sessions  Session[]
  debts     Debt[]

  @@map("users")
}

/// A debt the logged-in user owes to someone ("Me -> person").
model Debt {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      String
  amount      Decimal   @db.Decimal(12, 2)
  description String    @default("")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("debts")
}

/// Login sessions; only the SHA-256 of the cookie token is stored.
model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}
