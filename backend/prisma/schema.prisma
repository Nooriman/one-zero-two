generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One row per person. The access code is stored only as a salted scrypt hash.
model User {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  codeHash      String      @map("code_hash")
  codeSalt      String      @map("code_salt")
  /// Monthly spending limit shown on the dashboard; null until set.
  monthlyBudget Decimal?    @map("monthly_budget") @db.Decimal(12, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  sessions      Session[]
  debts         Debt[]
  expenses      Expense[]
  liabilities   Liability[]
  documents     Document[]

  @@map("users")
}

/// A titled note/document owned by the logged-in user.
model Document {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("documents")
}

/// An expense owned by the logged-in user.
model Expense {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String     @default("")
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  /// Set when this expense is the payment of a monthly liability; deleting the liability keeps the expense.
  liabilityId Int?       @map("liability_id")
  liability   Liability? @relation(fields: [liabilityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([liabilityId])
  @@map("expenses")
}

/// A monthly liability both of us must pay regardless of day-to-day expenses.
model Liability {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String    @default("")
  amount        Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  /// First moment this liability counts; changes are made to start at the next month boundary.
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  /// Exclusive end: the liability no longer counts from this moment. Null while it is still current.
  endsAt        DateTime? @map("ends_at")
  expenses      Expense[]

  @@index([userId, createdAt])
  @@map("liabilities")
}

/// A debt the logged-in user owes to someone ("Me -> person").
model Debt {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      String
  amount      Decimal   @db.Decimal(12, 2)
  description String    @default("")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("debts")
}

/// Login sessions; only the SHA-256 of the cookie token is stored.
model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}
